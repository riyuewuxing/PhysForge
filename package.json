{
  "name": "physforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present build",
    "dev:web": "pnpm --filter @physforge/web dev",
    "export:singlefile": "pnpm --filter @physforge/singlefile-exporter run export",
    "verify:packs": "node ./scripts/run-verify-packs.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
